# Preserve acquired HTML byte-for-byte, including legacy encodings and publisher whitespace.
/research/style-aggregation/datasets/*/raw/*.html -text -diff
/research/style-aggregation/datasets/*/sources/*.md -text
# P6 document fixtures and frozen binary sources retain exact bytes (PDF xref whitespace included).
/research/style-aggregation/runs/learning-formats-local-01/fixtures/*.pdf -text -diff
/research/style-aggregation/runs/learning-formats-local-01/mixed-workspace/**/blobs/* -text -diff
